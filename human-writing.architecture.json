  "cards": [
    {
      "dot": "cyan",
      "title": "写作主路径",
      "items": [
        "非虚构长文先过材料门槛，列不出五件具体材料就不动笔",
        "参考文件按任务命中读取，revision.md 留到初稿之后",
        "check_prose.py 失败就继续修改，直到硬禁令清零"
      ]
    },
    {
      "dot": "emerald",
      "title": "Skill 包内",
      "items": [
        "五个 references 分管长帖、现实、虚构、特殊形式与改稿",
        "检查器只执行写明的硬禁令，翻案腔变形与统计项只警告",
        "交稿只交作品本体，不展示提纲、规则检查与创作过程"
      ]
    },
    {
      "dot": "amber",
      "title": "边界之外",
      "items": [
        "GitHub Releases 是唯一安装来源，MIT 协议，无第三方语料",
        "环境不支持 Skill 时改用两千字蒸馏版，粘贴进聊天窗口",
        "不建立作者画像，不生成个人规则库或新 Skill"
      ]
    }
  ]
